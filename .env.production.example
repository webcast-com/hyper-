NODE_ENV="production"
DATA_DRIVER="prisma"
DATABASE_URL="postgresql://creator:creator_password_change_me@localhost:5432/creator_connect?schema=public"
SESSION_SECRET="replace-with-a-long-random-production-secret"
ADMIN_EMAIL="owner@your-domain.com"
ADMIN_PASSWORD="replace-with-a-strong-owner-password"
ADMIN_NAME="Platform Owner"
ADMIN_USERNAME="owner"
# Set true only when intentionally rotating the existing bootstrapped admin password.
ADMIN_PASSWORD_ROTATE="false"
CRON_SECRET="replace-with-a-random-cron-secret"
APP_URL="https://your-domain.com"

# Media provider options: local, cloudinary, s3 scaffold
MEDIA_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
CLOUDINARY_FOLDER="creator-connect"
