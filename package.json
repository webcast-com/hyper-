{
  "name": "creator-connect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed-json-to-prisma.mjs",
    "db:setup": "prisma generate --schema prisma/schema.sqlite.prisma && prisma db push --schema prisma/schema.sqlite.prisma && node prisma/seed-json-to-prisma.mjs",
    "dev:prisma": "DATA_DRIVER=prisma next dev",
    "start:prisma": "DATA_DRIVER=prisma next start",
    "dev:json": "DATA_DRIVER=json next dev",
    "start:json": "DATA_DRIVER=json next start",
    "maintenance": "node scripts/maintenance.mjs",
    "prisma:validate": "prisma validate",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "prisma:validate:sqlite": "prisma validate --schema prisma/schema.sqlite.prisma",
    "prisma:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "migrate:deploy": "prisma migrate deploy",
    "db:setup:postgres": "prisma generate && prisma migrate deploy && node scripts/bootstrap-admin.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "data:export": "node scripts/export-data.mjs",
    "data:import": "node scripts/import-data.mjs",
    "backups:prune": "node scripts/prune-backups.mjs",
    "scripts:check": "node --check scripts/export-data.mjs && node --check scripts/import-data.mjs && node --check scripts/prune-backups.mjs && node --check scripts/maintenance.mjs && node --check scripts/bootstrap-admin.mjs && sh -n scripts/backup-postgres.sh && sh -n scripts/restore-postgres.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.4",
    "prisma": "^6.10.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
