generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  name         String
  username     String   @unique
  email        String   @unique
  emailVerified Boolean @default(false)
  passwordHash String
  bio          String
  niche        String
  website      String?
  avatar       String
  banner       String

  followers    String   @default("[]") // JSON array of user ids
  following    String   @default("[]") // JSON array of user ids
  friends      String   @default("[]") // JSON array of user ids
  blockedUsers String   @default("[]") // JSON array of user ids
  mutedUsers   String   @default("[]") // JSON array of user ids
  savedPosts   String   @default("[]") // JSON array of post ids
  settings     String   @default("{}") // JSON UserSettings

  isAdmin      Boolean  @default(false)
  roles        String   @default("[\"user\"]") // JSON Role[]
  suspended    Boolean  @default(false)
  referralCode String   @unique
  createdAt    DateTime @default(now())

  posts               Post[]
  comments            Comment[]
  stories             Story[]
  ownedGroups         Group[]              @relation("OwnedGroups")
  hostedEvents        Event[]              @relation("HostedEvents")
  hostedChallenges    Challenge[]          @relation("HostedChallenges")
  challengeEntries    ChallengeEntry[]
  marketplaceListings MarketplaceListing[]
  buyerInquiries      MarketplaceInquiry[] @relation("BuyerInquiries")
  sellerInquiries     MarketplaceInquiry[] @relation("SellerInquiries")
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  notificationsIn     Notification[]       @relation("RecipientNotifications")
  notificationsOut    Notification[]       @relation("ActorNotifications")
  reports             Report[]
  referralsSent       Referral[]           @relation("InviterReferrals")
  referralsReceived   Referral[]           @relation("InvitedReferrals")
  mediaAssets         MediaAsset[]
  authTokens          AuthToken[]
  sentFriendRequests     FriendRequest[]      @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]      @relation("FriendRequestRecipient")
  auditLogs              AuditLog[]
  notificationDigests    NotificationDigest[]
  followingEdges         Follow[]             @relation("Following")
  followerEdges          Follow[]             @relation("FollowedBy")
  friendships            Friendship[]         @relation("FriendshipOwner")
  friendOf               Friendship[]         @relation("FriendshipPeer")
  blocksIssued           UserBlock[]          @relation("Blocker")
  blocksReceived         UserBlock[]          @relation("Blocked")
  mutesIssued            UserMute[]           @relation("Muter")
  mutesReceived          UserMute[]           @relation("Muted")
  savedPostRows          SavedPost[]
  postLikes              PostLike[]
  commentLikes           CommentLike[]
  groupMemberships       GroupMember[]
  eventAttendances       EventAttendee[]
  conversationLinks      ConversationParticipant[]
  listingSaves           ListingSave[]
  challengeVotes         ChallengeEntryVote[]

  @@index([username])
  @@index([email])
  @@index([referralCode])
}

model Post {
  id         String   @id
  authorId   String
  groupId    String?
  eventId    String?
  body       String
  imageUrl   String?
  poll       String?  // JSON Poll
  tags       String   @default("[]") // JSON string[]
  visibility String   @default("public")
  likes      String   @default("[]") // JSON user ids
  reactions  String   @default("{}") // JSON reaction map
  shares     Int      @default(0)
  createdAt  DateTime @default(now())

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  comments      Comment[]
  notifications Notification[]
  likeRows      PostLike[]
  tagRows       PostTag[]
  savedBy       SavedPost[]

  @@index([authorId])
  @@index([groupId])
  @@index([eventId])
  @@index([createdAt])
  @@index([visibility])
}

model Comment {
  id        String   @id
  postId    String
  userId    String
  parentId  String?
  text      String
  likes     String   @default("[]") // JSON user ids
  createdAt DateTime @default(now())

  post   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Comment[] @relation("CommentReplies")
  likeRows CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model Notification {
  id          String   @id
  recipientId String
  actorId     String
  type        String
  postId      String?
  commentId   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([actorId])
  @@index([read])
  @@index([createdAt])
}

model Conversation {
  id             String   @id
  participantIds String   // JSON user ids
  updatedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  messages     Message[]
  participants ConversationParticipant[]

  @@index([updatedAt])
}

model Message {
  id             String   @id
  conversationId String
  senderId       String
  recipientId    String
  text           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User         @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([read])
}

model Story {
  id        String   @id
  authorId  String
  body      String
  imageUrl  String?
  views     String   @default("[]") // JSON user ids
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([expiresAt])
}

model Group {
  id          String   @id
  name        String
  description String
  cover       String
  ownerId     String
  memberIds   String   @default("[]") // JSON user ids
  createdAt   DateTime @default(now())

  owner        User         @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  posts        Post[]
  memberships  GroupMember[]

  @@index([ownerId])
}

model Event {
  id          String   @id
  title       String
  description String
  location    String
  startsAt    DateTime
  hostId      String
  attendeeIds String   @default("[]") // JSON user ids
  cover       String
  createdAt   DateTime @default(now())

  host       User            @relation("HostedEvents", fields: [hostId], references: [id], onDelete: Cascade)
  posts      Post[]
  attendees  EventAttendee[]

  @@index([hostId])
  @@index([startsAt])
}

model Challenge {
  id          String   @id
  title       String
  description String
  theme       String
  prize       String
  startsAt    DateTime
  endsAt      DateTime
  hostId      String
  createdAt   DateTime @default(now())

  host    User             @relation("HostedChallenges", fields: [hostId], references: [id], onDelete: Cascade)
  entries ChallengeEntry[]

  @@index([hostId])
  @@index([endsAt])
}

model ChallengeEntry {
  id          String   @id
  challengeId String
  authorId    String
  title       String
  body        String
  imageUrl    String?
  votes       String   @default("[]") // JSON user ids
  createdAt   DateTime @default(now())

  challenge Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  voteRows  ChallengeEntryVote[]

  @@index([challengeId])
  @@index([authorId])
}

model MarketplaceListing {
  id          String   @id
  sellerId    String
  title       String
  description String
  type        String
  category    String
  price       Float
  currency    String
  imageUrl    String?
  tags        String   @default("[]") // JSON string[]
  saves       String   @default("[]") // JSON user ids
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  seller    User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  inquiries MarketplaceInquiry[]
  saveRows  ListingSave[]

  @@index([sellerId])
  @@index([category])
  @@index([type])
  @@index([active])
}

model MarketplaceInquiry {
  id        String   @id
  listingId String
  buyerId   String
  sellerId  String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User               @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User               @relation("SellerInquiries", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
}

model FriendRequest {
  id          String   @id
  senderId    String
  recipientId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  sender    User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
}

model Report {
  id         String   @id
  reporterId String
  targetType String
  targetId   String
  reason     String
  details    String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType])
  @@index([targetId])
  @@index([status])
}

model Referral {
  id            String   @id
  inviterId     String
  invitedUserId String
  code          String
  createdAt     DateTime @default(now())

  inviter     User @relation("InviterReferrals", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedUser User @relation("InvitedReferrals", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([invitedUserId])
  @@index([code])
}

model MediaAsset {
  id        String   @id
  ownerId   String
  url       String
  provider  String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([provider])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id
  actorId   String?
  action    String
  targetType String?
  targetId   String?
  metadata  String   @default("{}")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model AuthToken {
  id        String   @id
  userId    String
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model WebhookEndpoint {
  id          String   @id
  url         String
  description String
  secret      String
  events      String   @default("[]") // JSON event names, empty means all
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([active])
  @@index([createdAt])
}

model WebhookDelivery {
  id          String   @id
  endpointId  String
  event       String
  payload     String
  status      String   @default("pending")
  statusCode  Int?
  response    String?
  attempts    Int      @default(0)
  nextAttemptAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([event])
  @@index([status])
  @@index([createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  description String?
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([enabled])
}

model ModerationRule {
  id          String   @id
  phrase      String
  targetTypes String   @default("[]") // JSON target types; empty means all
  action      String   @default("flag") // flag | block
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flags ModerationFlag[]

  @@index([active])
  @@index([action])
}

model ModerationFlag {
  id         String   @id
  ruleId     String?
  targetType String
  targetId   String
  actorId    String?
  excerpt    String
  status     String   @default("open") // open | reviewed | dismissed
  createdAt  DateTime @default(now())

  rule ModerationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([targetId])
  @@index([actorId])
  @@index([status])
  @@index([createdAt])
}

model NotificationDigest {
  id        String   @id
  userId    String
  frequency String
  subject   String
  itemCount Int
  status    String   @default("pending") // pending | sent | failed
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([frequency])
  @@index([status])
  @@index([createdAt])
}

model AdminMetricSnapshot {
  id        String   @id
  date      String   @unique
  metrics   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AdminAlert {
  id        String   @id
  type      String
  severity  String   @default("info") // info | warning | critical
  title     String
  message   String
  status    String   @default("open") // open | acknowledged | resolved
  source    String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  resolvedBy String?

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Friendship {
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipPeer", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
}

model UserBlock {
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())

  user    User @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([userId, blockedUserId])
  @@index([blockedUserId])
}

model UserMute {
  userId      String
  mutedUserId String
  createdAt   DateTime @default(now())

  user  User @relation("Muter", fields: [userId], references: [id], onDelete: Cascade)
  muted User @relation("Muted", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@id([userId, mutedUserId])
  @@index([mutedUserId])
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model PostTag {
  postId    String
  tag       String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, tag])
  @@index([tag])
}

model GroupMember {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model EventAttendee {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model ListingSave {
  listingId String
  userId    String
  createdAt DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listingId, userId])
  @@index([userId])
}

model ChallengeEntryVote {
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entryId, userId])
  @@index([userId])
}
