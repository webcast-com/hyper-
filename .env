# Copy to .env.local and change this before deploying.
SESSION_SECRET="replace-with-a-long-random-secret"
DATABASE_URL="postgres://e4843cc5f2f24069cc19604065b9751b9adc1ea8b500a9587b711b300dd2f8f6:sk_9DiZtLGOlFGzrzsnurYS7@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Runtime data driver: Prisma is the primary backend. Use DATA_DRIVER="json" only for legacy local JSON mode.
DATA_DRIVER="prisma"
# Media upload provider. local writes to public/uploads. cloudinary uses unsigned upload preset.
MEDIA_PROVIDER="local"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_UPLOAD_PRESET=""
# CLOUDINARY_FOLDER="creator-connect"
# Optional secret for calling /api/admin/maintenance from cron without a browser session.
CRON_SECRET="replace-with-a-random-cron-secret"
# Optional app URL for npm run maintenance
APP_URL="http://localhost:3000"
# Rate limiting: auto uses Upstash Redis if configured, otherwise memory fallback. Use memory for local-only.
RATE_LIMIT_DRIVER="auto"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Transactional mail provider. console prints links in dev logs.
MAIL_PROVIDER="console"
# For production transactional email, use Resend:
# MAIL_PROVIDER="resend"
# RESEND_API_KEY="re_xxxxxxxxx"
# MAIL_FROM="Creator Connect <hello@your-domain.com>"
MAIL_FALLBACK_TO_CONSOLE="true"
# Optional monitoring webhook for server-side error capture.
MONITORING_WEBHOOK_URL=""
# Optional structured log level placeholder for external log collectors.
LOG_LEVEL="info"
