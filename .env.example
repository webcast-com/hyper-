# Copy to .env.local and change this before deploying.
SESSION_SECRET="replace-with-a-long-random-secret"
# Prisma/Postgres DSN. Ignored when DATA_DRIVER="json".
# Local sqlite is a separate optional path: npm run db:setup uses prisma/schema.sqlite.prisma
# and a file: DATABASE_URL. Do not point this Postgres schema at prisma/dev.db.
DATABASE_URL="postgresql://creator:creator_password_change_me@localhost:5432/creator_connect?schema=public"
# Dual backend: "prisma" uses DATABASE_URL. "json" uses data/db.json and never loads Prisma Client.
DATA_DRIVER="prisma"
# Media upload provider. local writes to public/uploads. cloudinary uses unsigned upload preset.
MEDIA_PROVIDER="local"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_UPLOAD_PRESET=""
# CLOUDINARY_FOLDER="creator-connect"
# Optional secret for calling /api/admin/maintenance from cron without a browser session.
CRON_SECRET="replace-with-a-random-cron-secret"
# Optional app URL for npm run maintenance
APP_URL="http://localhost:3000"
# Set to "true" only when the app is served over HTTPS inside a cross-site iframe
# (e.g. a hosted dev preview). It switches the session cookie to SameSite=None; Secure
# so the browser will send it in a third-party context. Leave unset in normal
# deployments: the default SameSite=Lax is what protects this app against CSRF.
# CROSS_SITE_COOKIES="false"
# Rate limiting: auto uses Upstash Redis if configured, otherwise memory fallback. Use memory for local-only.
RATE_LIMIT_DRIVER="auto"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Transactional mail provider. console prints links in dev logs.
MAIL_PROVIDER="console"
# For production transactional email, use Resend:
# MAIL_PROVIDER="resend"
# RESEND_API_KEY="re_xxxxxxxxx"
# MAIL_FROM="Creator Connect <hello@your-domain.com>"
MAIL_FALLBACK_TO_CONSOLE="true"
# Optional monitoring webhook for server-side error capture.
MONITORING_WEBHOOK_URL=""
# Optional structured log level placeholder for external log collectors.
LOG_LEVEL="info"
